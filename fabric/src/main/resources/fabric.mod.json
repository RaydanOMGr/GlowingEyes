  "description": "${description}",
  "authors": [
    "AndreasMelone"
  ],
  "contact": {
    "repo": "https://github.com/RaydanOMGr/glowingeyes"
  },
  "license": "${license}",
  "icon": "assets/glowingeyes/logo.png",
  "environment": "*",
